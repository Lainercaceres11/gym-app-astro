---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <div class="min-h-screen bg-slate-950 text-slate-100">

    <section class="relative overflow-hidden">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.12),transparent_35%),radial-gradient(circle_at_right,rgba(45,212,191,0.10),transparent_22%)]"
      >
      </div>

      <div
        class="relative mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 py-16"
      >
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_420px]">
          <div class="max-w-3xl">
            <div
              class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-emerald-300"
            >
              <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
              Astro Pro Platform
            </div>

            <h1
              class="text-6xl font-black leading-none tracking-tight text-white md:text-7xl"
            >
              Design your<br />next digital flow
            </h1>

            <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-300">
              Launch faster with a modern full-stack workspace for teams that
              need secure authentication, scalable content, and a clean customer
              experience.
            </p>

            <div class="mt-10 flex flex-wrap items-center gap-4">
              <a
                href={`/${lang}/register`}
                class="rounded-2xl bg-emerald-400 px-8 py-4 text-sm font-black text-slate-950 shadow-xl shadow-emerald-500/25 transition hover:bg-emerald-300"
              >
                Create account
              </a>
              <a
                href={`/${lang}/login`}
                class="rounded-2xl border border-white/15 px-8 py-4 text-sm font-black text-white transition hover:bg-white/10"
              >
                Sign in
              </a>
            </div>

            <div class="mt-12 flex flex-wrap gap-8">
              <div>
                <p class="text-3xl font-black text-white">24k+</p>
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Active users
                </p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">99.9%</p>
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Uptime
                </p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">7 days</p>
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Free trial
                </p>
              </div>
            </div>
          </div>

          <aside class="relative">
            <div
              class="rounded-4xl border border-white/10 bg-white/8 p-2 shadow-2xl shadow-emerald-950/50 backdrop-blur-xl"
            >
              <div
                class="rounded-[1.65rem] border border-white/10 bg-slate-900/80 p-7"
              >
                <div class="flex items-center justify-between">
                  <span
                    class="text-xs font-black uppercase tracking-[0.2em] text-emerald-300"
                    >Workspace</span
                  >
                  <span
                    class="rounded-full border border-emerald-300/50 px-3 py-1 text-[11px] font-bold text-emerald-300"
                  >
                    Live
                  </span>
                </div>

                <div class="mt-8 flex items-center gap-4">
                  <div
                    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-400 text-2xl font-black text-slate-950"
                  >
                    AP
                  </div>
                  <div>
                    <p class="text-sm text-slate-400">Welcome</p>
                    <h2 class="text-2xl font-black text-white">Astro Pro</h2>
                  </div>
                </div>

                <div class="mt-8 space-y-4">
                  <div
                    class="rounded-2xl border border-white/10 bg-white/5 p-4"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                        >Authentication</span
                      >
                      <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                    </div>
                    <p class="mt-3 text-sm text-slate-300">
                      Secure sign in with better-auth
                    </p>
                  </div>

                  <div
                    class="rounded-2xl border border-white/10 bg-white/5 p-4"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                        >Database</span
                      >
                      <span class="h-2 w-2 rounded-full bg-sky-300"></span>
                    </div>
                    <p class="mt-3 text-sm text-slate-300">
                      Prisma-ready data model
                    </p>
                  </div>

                  <div
                    class="rounded-2xl border border-white/10 bg-white/5 p-4"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                        >Deploy</span
                      >
                      <span class="h-2 w-2 rounded-full bg-violet-300"></span>
                    </div>
                    <p class="mt-3 text-sm text-slate-300">
                      Astro + Vercel-ready
                    </p>
                  </div>
                </div>

                <div class="mt-8">
                  <button
                    class="w-full rounded-2xl border border-emerald-300/50 bg-emerald-400 px-5 py-3 text-sm font-black text-slate-950 transition hover:bg-emerald-300"
                  >
                    Start building
                  </button>
                </div>
              </div>
            </div>
          </aside>
        </div>

        <section class="mt-20 grid gap-6 md:grid-cols-3">
          <article class="rounded-3xl border border-white/10 bg-white/4 p-7">
            <div
              class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-400/15 text-emerald-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15l8-8M12 15l-8-8M12 15v7"></path>
              </svg>
            </div>
            <h3 class="text-xl font-black text-white">Authentication</h3>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              Sign in and sign up flows ready for modern users.
            </p>
          </article>

          <article class="rounded-3xl border border-white/10 bg-white/4 p-7">
            <div
              class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-400/15 text-sky-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 7h16v10H4z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-black text-white">Content</h3>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              Build pages, routes and collections with confidence.
            </p>
          </article>

          <article class="rounded-3xl border border-white/10 bg-white/4 p-7">
            <div
              class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-400/15 text-violet-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7l-1 7 9-14h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-black text-white">Performance</h3>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              Fast rendering and developer experience from Astro.
            </p>
          </article>
        </section>
      </div>
    </section>
  </div>
</Layout>
