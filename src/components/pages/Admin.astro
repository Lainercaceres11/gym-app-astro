---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen bg-slate-950 text-slate-100">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <header
        class="rounded-4xl border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/40 backdrop-blur-xl"
      >
        <div
          class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"
        >
          <div>
            <p
              class="text-xs font-black uppercase tracking-[0.32em] text-emerald-300"
            >
              Control de acceso
            </p>
            <h1
              class="mt-3 text-4xl font-black tracking-tight text-white md:text-5xl"
            >
              Panel administrativo
            </h1>
          </div>

          <div
            class="inline-flex items-center gap-3 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-200"
          >
            <span
              class="h-2.5 w-2.5 rounded-full bg-emerald-300 shadow-[0_0_12px_rgba(110,231,183,0.9)]"
            ></span>
            Sistema activo
          </div>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <article
            class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
          >
            <p
              class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
            >
              Miembros activos
            </p>
            <div class="mt-4 flex items-end justify-between">
              <span class="text-3xl font-black text-white">1.284</span>
              <span
                class="rounded-full bg-emerald-400/15 px-2.5 py-1 text-xs font-bold text-emerald-300"
              >
                +8.4%
              </span>
            </div>
          </article>

          <article
            class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
          >
            <p
              class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
            >
              Accesos hoy
            </p>
            <div class="mt-4 flex items-end justify-between">
              <span class="text-3xl font-black text-white">437</span>
              <span
                class="rounded-full bg-sky-400/15 px-2.5 py-1 text-xs font-bold text-sky-300"
              >
                94% OK
              </span>
            </div>
          </article>

          <article
            class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
          >
            <p
              class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
            >
              Renovaciones
            </p>
            <div class="mt-4 flex items-end justify-between">
              <span class="text-3xl font-black text-white">72</span>
              <span
                class="rounded-full bg-violet-400/15 px-2.5 py-1 text-xs font-bold text-violet-300"
              >
                5 pendientes
              </span>
            </div>
          </article>
        </div>
      </header>

      <section
        class="mt-8 rounded-[28px] border border-white/10 bg-slate-900/70 p-6 shadow-2xl shadow-black/20"
      >
        <div class="flex items-center justify-between gap-4">
          <div>
            <p
              class="text-xs font-bold uppercase tracking-[0.28em] text-slate-400"
            >
              Monitoreo en vivo
            </p>
            <h2 class="mt-2 text-2xl font-black text-white">
              Registro de accesos
            </h2>
          </div>

          <div
            class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.22em] text-emerald-200"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
            Live
          </div>
        </div>

        <div class="mt-6 space-y-3" id="list-qr">
          <div
            class="flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-slate-950/60 p-4"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-400/15 text-sm font-black text-emerald-300"
              >
                A1
              </div>
              <div>
                <p class="text-sm font-semibold text-white">
                  Espera accesos en tiempo real
                </p>
                <p class="text-xs text-slate-400">Verificación QR pendiente</p>
              </div>
            </div>
            <div class="text-right">
              <p
                class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500"
              >
                Estado
              </p>
              <p class="mt-1 text-sm font-semibold text-emerald-300">
                En espera
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import Pusher from "pusher-js";

    const listQR = document.getElementById("list-qr") as HTMLDivElement;

    const pusher = new Pusher("d070ddd84f0d5c51c1a3", {
      cluster: "us2",
    });

    const channel = pusher.subscribe("gym-access");
    channel.bind(
      "new-access",
      function ({ userId, timestamp }: { userId: string; timestamp: string }) {
        listQR.innerHTML = `
    
      <div class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-white/10 bg-slate-950/60 p-4">
         <p>User id: ${userId}</p>
        <p>Fecha de ingreso: ${timestamp}</p></div>

      `;
      },
    );
  </script>
</Layout>
