---
import Layout from "@/layouts/Layout.astro";
import type { Session, User } from "better-auth";
import { getLangFromUrl } from "@/i18n/utils";
import QRGenerator from "../qr-generator";
import type { Plan } from "../../../prisma/generated/enums";

const user = Astro.locals.user!;

const session = Astro.locals.session as Session;
const lang = getLangFromUrl(Astro.url);

type PlanType = typeof Plan.BASIC | typeof Plan.PRO;
---

<Layout>
  <main class="min-h-screen bg-slate-950 text-slate-100">
    <div class="min-h-screen px-6 py-10">
      <section class="mx-auto max-w-5xl">
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-bold uppercase tracking-[0.3em] text-emerald-300"
            >
              Account
            </p>
            <h1 class="mt-3 text-4xl font-black tracking-tight text-white">
              User Profile
            </h1>
          </div>
          <button
            class="rounded-xl border border-white/15 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10"
          >
            Edit profile
          </button>
        </div>

        <section class="mt-8 grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
          <article
            class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl shadow-black/30"
          >
            <div class="flex items-center gap-5">
              <div
                class="flex h-24 w-24 items-center justify-center rounded-full bg-linear-to-br from-emerald-300 to-sky-500 text-3xl font-black text-slate-950"
              >
                AM
              </div>
              <div>
                <p
                  class="text-sm font-semibold uppercase tracking-[0.25em] text-emerald-300"
                >
                  Member
                </p>
                <h2 class="mt-2 text-3xl font-bold text-white">{user.name}</h2>
                <p class="mt-1 text-sm text-slate-400">{user.email}</p>
              </div>
            </div>

            <div class="mt-8 grid gap-4">
              <div
                class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/50 px-4 py-4"
              >
                <span class="text-sm text-slate-400">Full name</span>
                <span class="text-sm font-semibold text-white">{user.name}</span
                >
              </div>
              <div
                class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/50 px-4 py-4"
              >
                <span class="text-sm text-slate-400">Email</span>
                <span class="text-sm font-semibold text-white"
                  >{user.email}</span
                >
              </div>
              <div
                class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/50 px-4 py-4"
              >
                <span class="text-sm text-slate-400">Role</span>
                <span
                  class="rounded-full bg-emerald-400/15 px-3 py-1 text-xs font-bold text-emerald-300"
                >
                  {user.role}
                </span>
              </div>
              <div
                class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/50 px-4 py-4"
              >
                <span class="text-sm text-slate-400">Language</span>
                <span class="text-sm font-semibold text-white">English</span>
              </div>
            </div>

            <div class="mt-8 flex items-center gap-4">
              <button
                id="logout"
                class="rounded-xl border border-rose-400/60 px-6 py-3 text-sm font-bold text-rose-200 transition hover:bg-rose-500/20 hover:text-white"
              >
                Logout
              </button>
            </div>
          </article>

          <article
            class="rounded-3xl border border-white/10 bg-slate-900/60 p-8 shadow-2xl shadow-black/30"
          >
            <div class="flex items-center justify-between">
              <div>
                <p
                  class="text-xs font-bold uppercase tracking-[0.3em] text-slate-400"
                >
                  Overview
                </p>
                <h2 class="mt-2 text-2xl font-bold text-white">
                  Account Summary
                </h2>
              </div>
              <span
                class="rounded-full border border-emerald-400/40 bg-emerald-400/10 px-4 py-2 text-xs font-bold uppercase text-emerald-300"
              >
                Active
              </span>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Joined
                </p>
                <p class="mt-3 text-2xl font-black text-white">
                  {new Date(user.createdAt).toDateString()}
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Ip addres
                </p>
                <p class="mt-3 text-2xl font-black text-white">
                  {session.ipAddress}
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Status
                </p>
                <p class="mt-3 text-2xl font-black text-emerald-300">
                  {user.emailVerified ? "Verified" : "Not verified"}
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p
                  class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                >
                  Plan
                </p>
                <p class="mt-3 text-2xl font-black text-white">
                  {user.plan}
                </p>

                <a
                  href={`/${lang}/subscribe`}
                  class="mt-3 block text-sm font-bold text-emerald-300 hover:text-emerald-200"
                >
                  Cambiar plan
                </a>
              </div>
            </div>

            <div
              class="mt-8 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 p-5"
            >
              <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-emerald-200"
                  >Account health</span
                >
                <span class="text-sm font-black text-white">97%</span>
              </div>
              <div class="mt-4 h-2 rounded-full bg-white/10">
                <div class="h-2 w-[97%] rounded-full bg-emerald-300"></div>
              </div>

              <QRGenerator
                client:load
                userId={user.id}
                membershipType={user.plan as PlanType}
                expiresAt={Date.now() + 60 * 60 * 1000}
                nonce={crypto.randomUUID()}
              />
            </div>
          </article>
        </section>
      </section>
    </div>
  </main>

  <script>
    import { authClient } from "@/lib/auth-client";

    const logoutBtn = document.getElementById(
      "logout",
    ) as HTMLButtonElement | null;

    if (!logoutBtn) {
      throw new Error("Logout button not found");
    }

    logoutBtn.addEventListener("click", async () => {
      try {
        await authClient.signOut({
          callbackURL: "/",
          disableRedirect: true,
        });
      } catch (error) {
        console.error("Logout failed:", error);
      } finally {
        window.location.replace("/");
      }
    });
  </script>
</Layout>
