---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const errorTranslation = t("USER_ALREADY_EXISTS_USE_ANOTHER_EMAIL");

const clientErrorTranslations = {
  USER_ALREADY_EXISTS_USE_ANOTHER_EMAIL: errorTranslation,
};
---

<Layout>
  <div class="min-h-screen bg-slate-950 flex items-center justify-center px-4">
    <section class="w-full max-w-md">
      <div
        class="bg-white/10 border border-white/20 backdrop-blur-md rounded-2xl shadow-2xl shadow-black/50 p-8"
      >
        <div class="text-center">
          <span
            class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300 ring-1 ring-emerald-400/40"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14c-4.4 0-8 2.6-8 6h16c0-3.4-3.6-6-8-6z"
              ></path>
            </svg>
          </span>
          <h1 class="mt-6 text-3xl font-bold text-white">
            {t("auth.register.title")}
          </h1>
          <p class="mt-2 text-sm text-slate-300">
            {t("home.getStartedDesc")}
          </p>
        </div>

        <form
          data-translations={JSON.stringify(clientErrorTranslations)}
          class="mt-8 space-y-5"
          id="register-form"
        >
          <div>
            <label
              for="name"
              class="mb-2 block text-sm font-medium text-slate-200">Name</label
            >
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="w-full rounded-xl border border-slate-600 bg-slate-900/70 px-4 py-3 text-white placeholder-slate-400 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30"
              placeholder="Your name"
            />
          </div>

          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-medium text-slate-200">Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="w-full rounded-xl border border-slate-600 bg-slate-900/70 px-4 py-3 text-white placeholder-slate-400 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label
              for="password"
              class="mb-2 block text-sm font-medium text-slate-200"
              >Password</label
            >
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              required
              class="w-full rounded-xl border border-slate-600 bg-slate-900/70 px-4 py-3 text-white placeholder-slate-400 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-emerald-500 px-4 py-3 font-semibold text-slate-950 shadow-lg shadow-emerald-950/50 transition hover:bg-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-300"
          >
            Register
          </button>
        </form>

        <div class="hidden text-red mt-4 p-3 rounded-md" id="error-message">
        </div>

        <p class="mt-6 text-center text-sm text-slate-300">
          {t("auth.register.hasAccount")}
          <a
            href={`/${lang}/login`}
            class="ml-1 font-semibold text-emerald-300 hover:text-emerald-200"
          >
            {t("auth.register.signInLink")}
          </a>
        </p>
      </div>
    </section>
  </div>

  <script>
    import { authClient } from "@/lib/auth-client";
    import { getLangFromUrl } from "@/i18n/utils";
    const currentLang = getLangFromUrl(new URL(window.location.href));
    const form = document.getElementById("register-form") as HTMLFormElement;
    const errorMessage = document.getElementById(
      "error-message",
    ) as HTMLDivElement;
    const clientErrorTranslations = JSON.parse(
      form.dataset.translations || "{}",
    );

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get("name") as string;
      const email = formData.get("email") as string;
      const password = formData.get("password") as string;

      try {
        const { data, error } = await authClient.signUp.email({
          name,
          email,
          password,
          callbackURL: `${window.location.origin}/${currentLang}/dashboard`,
        });
        if (error) {
          const translatedError = clientErrorTranslations[error.code as string];
          errorMessage.textContent =
            translatedError || error.message || "Something went wrong";
          errorMessage.classList.remove("hidden");
        }

        if (data) {
          window.location.href = `/${currentLang}/email-verification`;
        }
      } catch (error) {
        const message =
          error instanceof Error ? error.message : "Something went wrong";

        errorMessage.textContent = message;
        errorMessage.classList.remove("hidden");
      }
    });
  </script>
</Layout>
